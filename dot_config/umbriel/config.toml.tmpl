# Umbriel starter config — https://docs.noctalia.dev/umbriel
# Validate without a session: umbriel config validate

[general]
autostart = [
    "systemctl --user restart sunshine.service",
    "~/.config/umbriel/lock-at-start.sh",
    "bash $HOME/.local/share/rices/{{ .rice.active }}/scripts/start.sh"
]
mod_key = "Super"
show_cheatsheet = false

[layout]
mode = "dwindle"

[include]
files = [
	"env.toml",
	"keybinds.toml",
	"colors.toml",
	"input.toml",
	"appearance.toml",
	"monitors.toml",
	"rules.toml"
]

[include.optional]
files = []
